# Google Cloud Project ID
GCLOUD_PROJECT=relix-6218b

# GCS Bucket for uploads (triggers the function)
GCS_UPLOAD_BUCKET=relix-6218b-relix-uploads

# GCS Bucket for data lake (where OCR results are stored)
DATA_LAKE_BUCKET=relix-data-lake

# Firebase Service Account Key (if needed for local dev)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Google Cloud Vision API Key (if not using ADC)
# GOOGLE_CLOUD_VISION_API_KEY=your-api-key